<template>
  <Container>
    <!-- 草地背景 -->
    <Rect :width="width" :height="height" :fillColor="bgColor" />
    
    <!-- 网格线 (可选，用于调试) -->
    <Rect 
      v-for="i in gridX" 
      :key="'vline-' + i"
      :x="i * tileSize"
      :width="1"
      :height="height"
      :fillColor="gridColor"
      :alpha="0.1"
    />
    <Rect 
      v-for="i in gridY" 
      :key="'hline-' + i"
      :y="i * tileSize"
      :width="width"
      :height="1"
      :fillColor="gridColor"
      :alpha="0.1"
    />
    
    <!-- 事件层 -->
    <EventLayerComponent></EventLayerComponent>
  </Container>
</template>

<script>
import { EventLayerComponent } from "@rpgjs/client"

const { data } = defineProps()

const bgColor = computed(() => data().color || '#3d6b3d')
const gridColor = '#000000'
const tileSize = 32
const width = computed(() => data().width || 640)
const height = computed(() => data().height || 480)
const gridX = computed(() => Math.floor(width.value / tileSize))
const gridY = computed(() => Math.floor(height.value / tileSize))
</script>
