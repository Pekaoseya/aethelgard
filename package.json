{
  "name": "stupid-adventure",
  "version": "1.0.0",
  "description": "智障探险队 - RPG-JS + AI 决策引擎 + rpg-mcp-engine",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "dev:ai": "pnpm -F @stupid-adventure/ai dev",
    "dev:mcp": "pnpm -F @stupid-adventure/rpg-mcp-engine dev",
    "build:ai": "pnpm -F @stupid-adventure/ai build",
    "build:mcp": "pnpm -F @stupid-adventure/rpg-mcp-engine build",
    "start:mcp": "pnpm -F @stupid-adventure/rpg-mcp-engine start",
    "test": "vitest"
  },
  "dependencies": {
    "vue": "^3.4.0",
    "pinia": "^2.1.0",
    "@stupid-adventure/ai": "workspace:*",
    "@stupid-adventure/rpg-mcp-engine": "workspace:*",
    "@rpgjs/client": "workspace:*",
    "@rpgjs/server": "workspace:*",
    "partysocket": "1.1.18"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vue-tsc": "^1.8.0",
    "tsx": "^4.21.0",
    "partykit": "0.0.115"
  },
  "workspaces": [
    "packages/*"
  ]
}
